## W3Ai and Plato Brand
##
## W3Ai and Plato must be treated as a brand.
##
## They cannot be:
## - Transliterated.
## - Translated.
##
## Declension should be avoided where possible, leaving the original
## brand unaltered in prominent UI positions.

-brand-shorter-name = W3Ai
-brand-short-name = W3Ai
-brand-shortcut-name = W3Ai
-brand-full-name = W3Ai by Plato
# This brand name can be used in messages where the product name needs to
# remain unchanged across different versions.
-brand-product-name = W3Ai
-vendor-short-name = Plato
trademarkInfo = { " " }
