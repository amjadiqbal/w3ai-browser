{
  "manifest_version": 2,
  "name": "W3Ai Exchange",
  "description": "Swap crypto assets instantly via Changelly — built into W3Ai browser.",
  "version": "151.0.1",
  "author": "W3Ai Team",

  "browser_specific_settings": {
    "gecko": {
      "id": "changelly-exchange@w3ai.io",
      "strict_min_version": "128.0",
      "update_url": "https://updates.w3ai.io/extensions/changelly-exchange/updates.json"
    }
  },

  "icons": {
    "16": "icons/icon-16.png",
    "19": "icons/icon-19.png",
    "32": "icons/icon-32.png",
    "38": "icons/icon-38.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },

  "browser_action": {
    "default_popup": "popup/index.html",
    "default_area": "navbar",
    "default_icon": {
      "16": "icons/icon-16.png",
      "19": "icons/icon-19.png",
      "32": "icons/icon-32.png",
      "38": "icons/icon-38.png",
      "48": "icons/icon-48.png"
    },
    "default_title": "W3Ai Exchange"
  },

  "sidebar_action": {
    "default_title": "W3Ai Exchange",
    "default_panel": "popup/index.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "19": "icons/icon-19.png",
      "32": "icons/icon-32.png",
      "38": "icons/icon-38.png",
      "48": "icons/icon-48.png"
    }
  },

  "background": {
    "scripts": ["background/index.js"],
    "persistent": false
  },

  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "https://proxy.w3ai.io/*",
    "http://127.0.0.1:3000/*",
    "http://localhost:3000/*"
  ],

  "content_security_policy": "default-src 'self'; connect-src https://proxy.w3ai.io http://127.0.0.1:3000 http://localhost:3000; img-src 'self' data: https://static.changelly.com https://raw.githubusercontent.com; style-src 'self' 'unsafe-inline'; font-src 'self' data:",

  "web_accessible_resources": ["icons/*", "fonts/*"]
}
