{
  "name": "changelly-proxy",
  "version": "1.0.0",
  "private": true,
  "description": "Backend proxy service for Changelly Exchange extension — signs requests, enforces rate limits",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "env:setup": "bash scripts/setup-env.sh",
    "test": "jest --forceExit",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "fastify": "^4.28.1",
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/rate-limit": "^9.1.0",
    "zod": "^3.23.8",
    "pino": "^9.3.2",
    "ioredis": "^5.4.1",
    "pg": "^8.12.0",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/node": "^22.1.0",
    "@types/pg": "^8.11.6",
    "typescript": "^5.5.3",
    "tsx": "^4.17.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.3",
    "@types/jest": "^29.5.12",
    "undici": "^6.19.7"
  },
  "engines": {
    "node": ">=20"
  }
}
