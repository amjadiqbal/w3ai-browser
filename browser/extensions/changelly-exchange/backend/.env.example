# Changelly Exchange Proxy — Environment Configuration
# Copy to .env and fill in values. NEVER commit .env to version control.

# ──────────────────────────────────────────────────────────────────────
# Server
# ──────────────────────────────────────────────────────────────────────
PORT=3000
HOST=127.0.0.1
NODE_ENV=development

# ──────────────────────────────────────────────────────────────────────
# Changelly API Credentials (KEEP SECRET — never expose to extension)
# Exchange API v2: https://changelly.com/developers
# ──────────────────────────────────────────────────────────────────────
CHANGELLY_API_KEY=your_api_key_here
CHANGELLY_API_SECRET=your_api_secret_here
CHANGELLY_API_BASE_URL=https://api.changelly.com/v2

# ──────────────────────────────────────────────────────────────────────
# Changelly DeFi Swap API
# ──────────────────────────────────────────────────────────────────────
CHANGELLY_DEFI_BASE_URL=https://dex-api.changelly.com/v1

# ──────────────────────────────────────────────────────────────────────
# Changelly Fiat API (On-Ramp / Off-Ramp)
# CHANGELLY_FIAT_API_PRIVATE_KEY supports PEM or base64-encoded PEM.
# ──────────────────────────────────────────────────────────────────────
CHANGELLY_FIAT_API_BASE_URL=https://fiat-api.changelly.com
CHANGELLY_FIAT_API_PUBLIC_KEY=your_fiat_public_key_here
CHANGELLY_FIAT_API_PRIVATE_KEY=your_fiat_private_key_here

# ──────────────────────────────────────────────────────────────────────
# Redis (rate limiting, nonce deduplication)
# ──────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ──────────────────────────────────────────────────────────────────────
# PostgreSQL (audit log)
# ──────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/changelly_proxy

# ──────────────────────────────────────────────────────────────────────
# CORS — allowed origins (the extension uses moz-extension:// scheme)
# ──────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=moz-extension://

# ──────────────────────────────────────────────────────────────────────
# Rate limits (requests per window per IP)
# ──────────────────────────────────────────────────────────────────────
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000
