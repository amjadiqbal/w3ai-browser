{
  "manifest_version": 2,
  "browser_specific_settings": {
    "gecko": {
      "id": "w3ai-liquid-glass@plato.org"
    }
  },
  "name": "Liquid Glass (W3Ai)",
  "description": "Translucent liquid glass theme with blur and tint effects.",
  "author": "W3Ai",
  "version": "1.0.0",
  "icons": { "32": "icon.svg" },
  "theme": {
    "images": {
      "additional_backgrounds": [
        "background-gradient.svg"
      ]
    },
    "properties": {
      "additional_backgrounds_alignment": ["right top"],
      "additional_backgrounds_tiling": ["repeat-x"],
      "zap_gradient": "linear-gradient(90deg, #0F4C93 0%, #2AA1FF 50%, #7AD0FF 100%)",
      "font_root": "16px"
    },
    "colors": {
      "frame": "hsla(210, 25%, 98%, 1)",
      "toolbar": "hsla(0, 0%, 100%, .76)",
      "button_background_active": "hsla(210, 80%, 30%, .16)",
      "button_background_hover": "hsla(210, 80%, 30%, .08)",
      "toolbar_text": "hsla(207, 90%, 40%, 1)",
      "icons_attention": "hsla(200, 100%, 40%, 1)",
      "toolbar_vertical_separator": "hsla(210, 20%, 20%, .2)",
      "toolbar_field": "hsla(0, 0%, 100%, .8)",
      "toolbar_field_focus": "hsla(210, 20%, 20%, .96)",
      "toolbar_field_text": "hsla(210, 20%, 20%, 1)",
      "toolbar_field_text_focus": "hsla(210, 100%, 95%, 1)",
      "toolbar_field_border": "transparent",
      "toolbar_field_border_focus": "hsla(210, 100%, 72%, 1)",
      "toolbar_field_highlight": "hsla(210, 100%, 72%, .32)",
      "toolbar_top_separator": "transparent",
      "toolbar_bottom_separator": "hsla(210, 20%, 20%, .32)",
      "bookmark_text": "hsla(210, 20%, 20%, 1)",
      "tab_text": "hsla(210, 20%, 20%, 1)",
      "tab_background_text": "hsla(210, 20%, 20%, 1)",
      "tab_background_separator": "hsla(210, 20%, 20%, 1)",
      "tab_line": "hsla(207, 90%, 50%, 1)",
      "tab_loading": "hsla(207, 90%, 50%, 1)",
      "ntp_background": "#F9F9FB",
      "ntp_text": "hsla(210, 20%, 20%, 1)",
      "popup": "hsla(205, 46%, 21%, 1)",
      "popup_text": "hsla(210, 100%, 95%, 1)",
      "popup_border": "hsla(210, 100%, 95%, .32)",
      "popup_highlight": "hsla(210, 100%, 95%, .12)",
      "popup_highlight_text": "hsla(0, 0%, 100%, 1)",
      "sidebar": "#FFFFFF",
      "sidebar_text": "hsla(210, 20%, 20%, 1)",
      "sidebar_border": "hsla(210, 20%, 20%, .24)",
      "sidebar_highlight": "hsla(207, 90%, 50%, 1)",
      "sidebar_highlight_text": "hsla(0, 0%, 100%, 1)",
      "focus_outline": "hsla(207, 90%, 50%, 1)",
      "text_primary": "hsla(210, 20%, 20%, 1)",
      "canvas_background": "#F9F9FB",
      "link": "#2AA1FF",
      "link_hover": "#80EBFF",
      "link_active": "#AAF2FF",
      "accent_primary": "#2AA1FF",
      "accent_primary_hover": "#80EBFF",
      "accent_primary_active": "#AAF2FF",
      "button_text": "hsla(210, 20%, 20%, 1)",
      "button_text_primary": "#FFFFFF"
    }
  },
  "dark_theme": {
    "images": {
      "additional_backgrounds": [
        "background-gradient-dark.svg"
      ]
    },
    "properties": {
      "additional_backgrounds_alignment": ["right top"],
      "additional_backgrounds_tiling": ["repeat-x"],
      "zap_gradient": "linear-gradient(90deg, #0F4C93 0%, #2AA1FF 50%, #7AD0FF 100%)",
      "font_root": "16px"
    },
    "colors": {
      "frame": "#0F1E3A",
      "toolbar": "hsla(205, 46%, 21%, .96)",
      "button_background_active": "hsla(210, 100%, 95%, .24)",
      "button_background_hover": "hsla(210, 100%, 95%, .12)",
      "icons": "hsla(207, 90%, 60%, 1)",
      "icons_attention": "hsla(190, 100%, 60%, 1)",
      "toolbar_text": "hsla(210, 100%, 95%, 1)",
      "toolbar_vertical_separator": "hsla(207, 90%, 60%, .4)",
      "toolbar_field": "hsla(205, 43%, 25%, 1)",
      "toolbar_field_focus": "hsla(205, 43%, 25%, .98)",
      "toolbar_field_text": "hsla(210, 100%, 95%, 1)",
      "toolbar_field_text_focus": "hsla(210, 100%, 95%, 1)",
      "toolbar_field_border": "transparent",
      "toolbar_field_border_focus": "hsla(207, 90%, 60%, 1)",
      "toolbar_field_highlight": "hsla(207, 90%, 60%, .32)",
      "toolbar_top_separator": "transparent",
      "toolbar_bottom_separator": "hsla(205, 38%, 33%, .96)",
      "bookmark_text": "hsla(210, 100%, 95%, 1)",
      "tab_selected": "#0E2D5E",
      "tab_text": "hsla(210, 100%, 95%, 1)",
      "tab_background_text": "hsla(210, 100%, 95%, 1)",
      "tab_background_separator": "hsla(210, 100%, 95%, 1)",
      "tab_line": "hsla(207, 90%, 60%, 1)",
      "tab_loading": "hsla(207, 90%, 60%, 1)",
      "ntp_background": "#2A2A2E",
      "ntp_text": "hsla(210, 100%, 95%, 1)",
      "popup": "hsla(205, 43%, 25%, 1)",
      "popup_text": "hsla(210, 100%, 95%, 1)",
      "popup_border": "hsla(210, 100%, 95%, .32)",
      "popup_highlight": "hsla(210, 100%, 95%, .12)",
      "popup_highlight_text": "hsla(0, 0%, 100%, 1)",
      "sidebar": "hsla(205, 43%, 25%, 1)",
      "sidebar_text": "hsla(210, 100%, 95%, 1)",
      "sidebar_border": "hsla(210, 100%, 95%, .24)",
      "sidebar_highlight": "hsla(207, 90%, 60%, 1)",
      "sidebar_highlight_text": "hsla(0, 0%, 100%, 1)",
      "focus_outline": "hsla(207, 90%, 60%, 1)",
      "text_primary": "hsla(210, 100%, 95%, 1)",
      "canvas_background": "#2A2A2E",
      "link": "#2AA1FF",
      "link_hover": "#80EBFF",
      "link_active": "#AAF2FF",
      "accent_primary": "#2AA1FF",
      "accent_primary_hover": "#80EBFF",
      "accent_primary_active": "#AAF2FF",
      "button_text": "hsla(210, 100%, 95%, 1)",
      "button_text_primary": "hsla(210, 100%, 95%, 1)"
    }
  },
  "theme_experiment": {
    "stylesheet": "liquid-glass-overrides.css",
    "colors": {
      "focus_outline": "--focus-outline-color",
      "text_primary": "--text-color",
      "canvas_background": "--background-color-canvas",
      "link": "--link-color",
      "link_hover": "--link-color-hover",
      "link_active": "--link-color-active",
      "accent_primary": "--color-accent-primary",
      "accent_primary_hover": "--color-accent-primary-hover",
      "accent_primary_active": "--color-accent-primary-active",
      "button_text": "--button-text-color",
      "button_text_primary": "--button-text-color-primary"
    },
    "properties": {
      "zap_gradient": "--panel-separator-zap-gradient",
      "font_root": "--font-size-root"
    }
  }
}
