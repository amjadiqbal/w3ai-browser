# TMRW W3 Browser — environment secrets template
# Copy this file to .env and fill in real values.
# .env is gitignored and must NEVER be committed.

# ── AI Provider API Keys ──────────────────────────────────────────────────────

# You.com API key (used by the W3Ai sidebar for search/research/finance tabs)
YOUCOM_API_KEY=

# xAI Grok API key  (https://console.x.ai)
GROK_API_KEY=

# Google Gemini API key  (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# Anthropic Claude API key  (https://console.anthropic.com/account/keys)
CLAUDE_API_KEY=

# OpenAI API key  (optional — for direct GPT access)
OPENAI_API_KEY=

# DeepSeek API key  (https://platform.deepseek.com/api_keys)
DEEPSEEK_API_KEY=

# ── macOS Notarization (Apple Developer) ─────────────────────────────────────
# Required to sign & notarize the TMRW W3 Browser .dmg for distribution.
#
# How to obtain:
#  1. Sign in to https://appleid.apple.com → Security → App-Specific Passwords
#     and generate a password labelled "notarytool".
#  2. Your Team ID is in https://developer.apple.com/account → Membership.

APPLE_ID=                        # your Apple Developer email
APPLE_APP_SPECIFIC_PASSWORD=     # app-specific password from step 1
APPLE_TEAM_ID=                   # 10-char team ID (e.g. AB12CD34EF)

# Bundle identifier — must match CFBundleIdentifier in Info.plist
APPLE_BUNDLE_ID=com.tmrw.w3ai

# Code-signing identity (run: security find-identity -v -p codesigning)
# Example: "Developer ID Application: Plato AI Inc (AB12CD34EF)"
APPLE_SIGNING_IDENTITY=

# PKG installer signing identity (run: security find-identity -v -p basic)
# Example: "Developer ID Installer: Plato AI Inc (AB12CD34EF)"
# Required by build-pkg.sh to sign and notarize the .pkg installer.
APPLE_INSTALLER_IDENTITY=

# Path to the Mac App Store distribution provisioning profile (.provisionprofile)
# Download from developer.apple.com → Profiles → Mac App Distribution
# macOS auto-deletes profiles from ~/Library/MobileDevice/Provisioning Profiles/
# so point this directly at the downloaded file (e.g. ~/Downloads/*.provisionprofile)
APPLE_PROVISIONING_PROFILE=

# Provisioning profile for the plugin-container helper process
APPLE_PLUGIN_CONTAINER_PROVISIONING_PROFILE=

# Note: there is no updater or crash reporter provisioning profile for
# TestFlight/App Store builds — scripts/package-testflight-macos.sh removes
# both updater.app and crashreporter.app entirely before signing (App Store
# handles updates and crash reporting; the in-app MAR updater and Gecko
# crash reporter are only used by the direct-DMG distribution build,
# scripts/notarize.sh).

# ── Build / Distribution ─────────────────────────────────────────────────────
# Path to the packaged .app (relative to repo root) — used by notarize.sh
BUILT_APP_PATH=obj-x86_64-apple-darwin25.5.0/dist/TMRW W3 Browser.app

# ── Update distribution ───────────────────────────────────────────────────────
# S3 bucket name — must be publicly readable, CORS-enabled
S3_BUCKET=tmrw-w3-browser-updates
# Public CDN/base URL for the bucket (CloudFront, R2, or direct S3 URL)
CDN_BASE=https://updates.tmrw.w3ai.io
